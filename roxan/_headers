/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://roxan.oplocloud.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

/mof/*
  ! Content-Security-Policy

# The app signs people in with the script every Oplo service shares (auth.oplocloud.com/connect.js, loaded only on
# the sign-in screen), which draws its progress bar with a <style> of its own, and asks api.oplocloud.com for a ticket.
# The rest of the policy is the one above. Rules are merged, so the first line removes the one it replaces.
/chat/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://auth.oplocloud.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://roxan.oplocloud.com https://api.oplocloud.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
