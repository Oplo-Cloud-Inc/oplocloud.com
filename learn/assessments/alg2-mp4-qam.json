          "prompt": [
            {
              "p": "Solve algebraically for x."
            },
            {
              "math": [
                "\\sqrt{2x − 7} + x = 5"
              ]
            }
          ],
          "response": {
            "type": "constructed",
            "work": "Show your work",
            "fields": [
              {
                "id": "answer",
                "label": "Solution"
              }
