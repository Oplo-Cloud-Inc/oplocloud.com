{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "oplo",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173"],
      "port": 4173
    },
    {
      "name": "oplo-node",
      "runtimeExecutable": "node",
      "runtimeArgs": [".claude/serve.js"],
      "port": 8123
    },
    {
      "name": "oplo-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "-c", "api/wrangler.toml", "--port", "8787", "--persist-to", "api/.wrangler/state"],
      "port": 8787
    }
  ]
}
