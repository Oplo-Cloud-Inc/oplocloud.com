{
  "name": "oplo-api",
  "version": "0.1.0",
  "private": true,
  "description": "The Oplo platform API — identity, organizations, and product data.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "db:create": "wrangler d1 create oplo-platform-db",
    "db:migrate:local": "wrangler d1 migrations apply oplo-platform-db --local",
    "db:migrate": "wrangler d1 migrations apply oplo-platform-db --remote",
    "db:console": "wrangler d1 execute oplo-platform-db --local --command"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "playwright-core": "^1.63.0",
    "wrangler": "^4.86.0"
  }
}
