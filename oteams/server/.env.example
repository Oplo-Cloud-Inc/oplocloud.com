# OTeams server — copy to ".env" and fill in.  cp .env.example .env
# NEVER commit the real .env (it is gitignored).

# ---------- HTTP ----------
PORT=8787
NODE_ENV=production
# Comma-separated origins allowed to call the API / open the WebSocket.
CORS_ORIGINS=https://oplocloud.com,http://localhost:4173

# ---------- Postgres ----------
# Inside docker compose the host is "db". For a local psql use localhost:5433.
DATABASE_URL=postgres://oteams:oteams@db:5432/oteams
PGSSLMODE=disable

# ---------- Oplo Accounts (ZITADEL) ----------
# The issuer URL of your ZITADEL instance (no trailing slash).
#   local prototype: http://localhost:8080
#   production:      https://accounts.oplo.com
OIDC_ISSUER=http://localhost:8080
# Optional: if your ZITADEL app issues JWT access tokens, set the expected audience
# (the Project ID / Client ID). Leave blank to skip the audience check.
OIDC_AUDIENCE=
# Seconds to cache a validated token's identity (reduces userinfo calls).
AUTH_CACHE_TTL=300

# ---------- Object storage (MinIO / any S3) ----------
S3_ENDPOINT=http://minio:9000
# Public base URL browsers use for presigned links (must be reachable from the browser).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=oteams
S3_ACCESS_KEY=oteams
S3_SECRET_KEY=CHANGE_ME_MIN_8_CHARS
S3_FORCE_PATH_STYLE=true
# Max upload size in bytes (25 MB default).
MAX_UPLOAD_BYTES=26214400

# ---------- WebRTC (huddles) ----------
# Advertised to clients so they can traverse NAT. Use your public host in prod.
TURN_URL=turn:localhost:3478
TURN_USER=oteams
TURN_PASSWORD=CHANGE_ME_TURN_SECRET
STUN_URL=stun:stun.l.google.com:19302

# ---------- Bootstrap ----------
# The first user to sign in with this email becomes owner of the default workspace.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_WORKSPACE_NAME=Northwind
BOOTSTRAP_WORKSPACE_SLUG=northwind
