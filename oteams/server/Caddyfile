# Production TLS termination for the OTeams API.
#   docker run -d --name caddy --network host \
#     -v $PWD/Caddyfile:/etc/caddy/Caddyfile -v caddy_data:/data caddy:2
#
# Caddy gets and renews Let's Encrypt certificates automatically.
# Replace the hostname with yours before using.

api.oteams.oplocloud.com {
	encode zstd gzip

	# Enforce HTTPS with HSTS
	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always

	# Security headers
	header X-Content-Type-Options "nosniff" always
	header X-Frame-Options "DENY" always
	header X-XSS-Protection "1; mode=block" always
	header Referrer-Policy "strict-origin-when-cross-origin" always
	header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always
	header -Server always

	# Content Security Policy - restricts resource loading to prevent XSS
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' wss: https://*.oplocloud.com; img-src 'self' data: blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" always

	# WebSocket upgrade and REST share one origin.
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output file /var/log/caddy/oteams.log
	}
}

# Presigned file links are served straight from MinIO.
files.oteams.oplocloud.com {
	reverse_proxy 127.0.0.1:9000
}
